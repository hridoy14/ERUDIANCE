{
  "version": "3.3.0",
  "display_name": "Erudience LinkedIn Content & Image Generation Plugin",
  "master_action": "@Erudience",
  "modules": [
    "business_service_intelligence",
    "competitor_intelligence",
    "buyer_intelligence",
    "market_trends",
    "topic_intelligence",
    "marketing_strategy",
    "funnel_planning",
    "linkedin_copywriting",
    "creative_brief",
    "image_generation",
    "brand_claims_qa",
    "approval_distribution",
    "analytics_learning",
    "knowledge_provenance"
  ],
  "production_capabilities": [
    "freshness_control",
    "competitor_monitoring",
    "topic_preservation",
    "asset_management",
    "mobile_readability",
    "experimentation",
    "feedback_loop",
    "audit_trail"
  ],
  "planning_slots_per_week": 7,
  "default_publish_posts_per_week": 4,
  "direct_promotion_slots_per_week": 1,
  "promotion_policy": "Exactly one dedicated service-promotion slot per full seven-slot editorial week; if unverified service/readiness, keep the slot HOLD rather than inventing a claim or substituting another promotion. Never force publication.",
  "research_competitor_target": 50,
  "research_competitor_groups": {
    "direct": 15,
    "niche_specialists": 10,
    "platforms": 10,
    "content_benchmarks": 10,
    "emerging": 5
  },
  "topic_statuses": [
    "READY",
    "ENRICH",
    "RESEARCH_NEEDED",
    "HOLD"
  ],
  "topic_delete_allowed": false,
  "external_write_default": false,
  "approval_required": true,
  "evidence_gate": "BLOCK if unsupported external facts, competitor metrics, brand assets or service readiness",
  "render_gate": "Do not claim generated images unless actual files rendered and inspected",
  "timezone": "Asia/Dhaka",
  "monthly_cycle_start_day": 21,
  "brand": {
    "heading": "Sora",
    "body": "Sora",
    "footer": "erudience.com",
    "name": "Erudience",
    "palette": {
      "paper": "#F6F1E9",
      "ink": "#14120E",
      "soft": "#615B4C",
      "emerald": "#10B77F",
      "deep": "#0A6E3E",
      "dark": "#0A100E"
    }
  },
  "brand_assets": {
    "approved_logo_path": "assets/erudience-owner-approved-logo-2026-11-21.jpg",
    "logo_optional": true,
    "generated_logos_allowed": false
  }
}
